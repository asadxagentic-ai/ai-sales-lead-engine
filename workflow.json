        "jsCode": "let phone = ($input.item.json['Phone Number'] ?? '').toString().replace(/[\\s\\-().]/g, '').trim();\n\n// If it doesn't start with +, just prepend it\nif (phone && !phone.startsWith('+')) {\n  phone = '+' + phone;\n}\n\n// Validate E.164: + followed by 7-15 digits\nif (!/^\\+\\d{7,15}$/.test(phone)) {\n  phone = '';\n}\n\nreturn { json: { ...$input.item.json, 'Phone Number': phone } };"
      },
