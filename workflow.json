    {
      "parameters": {
        "jsCode": "const COUNTRY_DIAL = {\n  PK: \"92\", US: \"1\", GB: \"44\", IN: \"91\", AU: \"61\",\n  CA: \"1\",  AE: \"971\", SA: \"966\", NG: \"234\", ZA: \"27\",\n  BD: \"880\", LK: \"94\", NP: \"977\", AF: \"93\"\n};\n\nconst results = [];\nfor (const item of $input.all()) {\n  const d = item.json;\n  const raw = (d.address || d.street || \"\").trim();\n  const parts = raw.split(\",\").map(s => s.trim());\n\n  // E.164 normalization\n  let phone = (d.phoneUnformatted || d.phone || \"\").replace(/[\\s\\-().]/g, \"\").trim();\n  if (phone) {\n    if (phone.startsWith(\"+\")) {\n      // already E.164\n    } else if (phone.startsWith(\"00\")) {\n      phone = \"+\" + phone.slice(2);\n    } else {\n      const cc = COUNTRY_DIAL[d.countryCode] || COUNTRY_DIAL[d.country] || \"92\";\n      phone = phone.replace(/^0+/, \"\"); // strip leading zeros\n      phone = \"+\" + cc + phone;\n    }\n  }\n\n  const name = (d.title || d.name || \"\").trim();\n  if (!name || !phone) continue;\n\n  results.push({ json: {\n    businessName:     name,\n    businessCategory: d.categoryName || (d.categories || [])[0] || \"\",\n    address:          parts[0] || raw,\n    city:             d.city  || parts[1] || \"\",\n    state:            d.state || (parts[2] || \"\").replace(/\\d{5}.*/, \"\").trim(),\n    country:          d.countryCode || d.country || \"\",\n    postalCode:       d.postalCode  || ((parts[2] || \"\").match(/\\d{5}/) || [])[0] || \"\",\n    googleRating:     String(d.totalScore || d.rating || \"\"),\n    phoneNumber:      phone,\n    email:            d.email   || \"\",\n    website:          (d.website || \"\").trim(),\n    googleMapsUrl:    d.url     || d.mapsUrl || \"\",\n    vapiCallResult:   \"\",\n    score:            \"\"\n  }});\n}\nreturn results;"
      },
